{
  "manifest_version": 3,
  "name": "Breez Call Display",
  "version": "1.1.0",
  "description": "A polished full-screen display for Breez browser test calls.",
  "web_accessible_resources": [
    {
      "resources": ["assets/menadevs-logo.png"],
      "matches": ["https://app.heybreez.ai/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://app.heybreez.ai/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://app.heybreez.ai/*"],
      "js": ["display.js"],
      "css": ["display.css"],
      "run_at": "document_start"
    }
  ]
}
